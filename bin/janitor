#!/bin/bash
# janitor — Mac developer housekeeper (Library-first, portable)
set -euo pipefail

JANITOR_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "$JANITOR_HOME/lib/common.sh"
# shellcheck source=../lib/config.sh
source "$JANITOR_HOME/lib/config.sh"
# shellcheck source=../lib/cleaners.sh
source "$JANITOR_HOME/lib/cleaners.sh"

janitor_augment_path
config_ensure

usage() {
  cat <<'EOF'
janitor — Mac developer housekeeper

Never touches ~/Documents or ~/Downloads.
Cleans ~/Library caches/logs/dev leftovers and known tool caches.

Usage:
  janitor clean [--dry-run] [--deep] [--only id,id,...] [-v]
  janitor desktop [--deep]
  janitor status
  janitor tasks
  janitor disable <task-id>
  janitor enable <task-id>
  janitor log [--path]
  janitor help

Commands:
  clean     Run cleanup (always writes a session log)
  desktop   GUI: assess → check tasks (opt-in) → clean
  status    Disk, RAM, reclaimable sizes
  tasks     List cleaners and enabled/disabled state
  disable   Permanently opt out of a task (saved in config)
  enable    Re-enable a previously disabled task
  log       Show latest session log
  help      Show this help

Options:
  --dry-run      Measure only; delete nothing
  --deep         Include larger Library/Caches app leftovers
  --only id,...  Run only these task ids (after assess selection)
  -v, --verbose  Show command output

Config (per user, portable):
  ~/.config/janitor/disabled

Desktop button:
  ./install.sh --desktop

Examples:
  janitor status
  janitor tasks
  janitor disable playwright
  janitor clean --dry-run
  janitor desktop
  janitor clean --only homebrew,npm,old_logs
EOF
}

cmd_status() {
  echo "🧹 Janitor status"
  echo
  df_data
  echo
  ram_report
  echo
  echo "Reclaimable / notable sizes (Library + tool caches):"
  report_sizes
  echo
  echo "Policy: ~/Documents and ~/Downloads are never touched."
  echo "Opt-outs: $JANITOR_DISABLED_FILE  (janitor tasks)"
  local latest
  latest="$(latest_log_path)"
  if [[ -n "$latest" && -f "$latest" ]]; then
    echo
    echo "Last run:"
    grep -E '^(Freed |df avail|Log:|# janitor)' "$latest" 2>/dev/null | sed 's/^/  /' \
      || echo "  (see $latest)"
  fi
}

cmd_log() {
  local path_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --path) path_only=1 ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  local latest
  latest="$(latest_log_path)"
  if [[ -z "$latest" || ! -f "$latest" ]]; then
    die "no logs yet — run: janitor clean --dry-run"
  fi
  local real="$latest"
  if [[ -L "$latest" ]]; then
    real="$(readlink "$latest" 2>/dev/null || echo "$latest")"
  fi
  if [[ "$path_only" -eq 1 ]]; then
    echo "$real"
    return 0
  fi
  echo "Log: $real"
  echo
  cat "$latest"
}

cmd_clean() {
  local dry_run=0 verbose=0 deep=0 only=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=1 ;;
      --deep) deep=1 ;;
      --only)
        shift
        [[ $# -gt 0 ]] || die "--only needs a comma-separated id list"
        only="$1"
        ;;
      --only=*)
        only="${1#--only=}"
        ;;
      -v|--verbose) verbose=1 ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  DRY_RUN=$dry_run
  VERBOSE=$verbose
  DEEP=$deep
  JANITOR_ONLY="$only"
  export DRY_RUN VERBOSE DEEP JANITOR_ONLY

  local df_before
  df_before="$(free_kb)"
  log_init "clean"

  log_echo "🧹 Developer cleanup"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log_echo "(dry-run — nothing will be deleted)"
  fi
  if [[ "$DEEP" -eq 1 ]]; then
    log_echo "(deep profile enabled)"
  fi
  if [[ -n "$JANITOR_ONLY" ]]; then
    log_echo "(only: $JANITOR_ONLY)"
  fi
  log_echo ""
  {
    echo "# RAM before"
    ram_report
    echo
  } | tee -a "$LOG_FILE"

  run_all_cleaners

  echo
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log_echo "✅ Dry-run complete."
  else
    log_echo "✅ Cleanup complete."
  fi
  log_finish "$df_before"
  echo
  {
    echo "# RAM after"
    ram_report
  } | tee -a "$LOG_FILE"
  echo
  df_data
}

cmd_desktop() {
  local deep=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --deep) deep=1 ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  if [[ "$deep" -eq 1 ]]; then
    export JANITOR_DESKTOP_DEEP=1
  fi
  exec "$JANITOR_HOME/bin/janitor-desktop"
}

cmd_tasks() {
  list_tasks
}

cmd_disable() {
  [[ $# -ge 1 ]] || die "usage: janitor disable <task-id>"
  local id="$1" known=0 t
  for t in "${JANITOR_TASK_IDS[@]}"; do
    [[ "$t" == "$id" ]] && known=1 && break
  done
  [[ "$known" -eq 1 ]] || die "unknown task id: $id (try: janitor tasks)"
  task_disable "$id"
}

cmd_enable() {
  [[ $# -ge 1 ]] || die "usage: janitor enable <task-id>"
  task_enable "$1"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    clean)   cmd_clean "$@" ;;
    desktop) cmd_desktop "$@" ;;
    status)  cmd_status "$@" ;;
    tasks)   cmd_tasks "$@" ;;
    disable) cmd_disable "$@" ;;
    enable)  cmd_enable "$@" ;;
    log)     cmd_log "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $cmd (try: janitor help)" ;;
  esac
}

main "$@"
