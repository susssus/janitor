#!/bin/bash
# janitor — Mac developer housekeeper (Library-first, portable)
set -euo pipefail

JANITOR_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "$JANITOR_HOME/lib/common.sh"
# shellcheck source=../lib/config.sh
source "$JANITOR_HOME/lib/config.sh"
# shellcheck source=../lib/cleaners.sh
source "$JANITOR_HOME/lib/cleaners.sh"

janitor_augment_path
config_ensure
janitor_hogs_init

usage() {
  cat <<'EOF'
janitor — Mac developer housekeeper

Dev caches only. Never touches ~/Documents, ~/Downloads, media, or personal files.

Usage:
  janitor clean [--dry-run] [--deep] [--brave|--stupid] [--only id,id,...] [-v]
  janitor desktop [--deep] [--brave]
  janitor status
  janitor hogs
  janitor discover
  janitor educate <id|ram>
  janitor adopt <id>
  janitor hog add <path> [remove|contents]
  janitor tasks
  janitor disable <task-id>
  janitor enable <task-id>
  janitor log [--path]
  janitor help

Commands:
  clean     Run cleanup (always writes a session log)
  desktop   GUI: assess → check tasks (opt-in) → clean
  status    Disk, RAM, reclaimable hogs (one 🐗 row each)
  hogs      List catalog + custom hogs and state
  discover  Suggest off/brave/disabled hogs present on disk
  educate   Longer explanation for one hog, or: janitor educate ram
  adopt     Opt into a catalog hog (saved in ~/.config/janitor/hogs)
  hog add   Add a custom allowlisted cache path as a hog
  tasks     List cleaners and enabled/disabled/off/brave state
  disable   Permanently opt out of a task (saved in config)
  enable    Re-enable a previously disabled task
  log       Show latest session log
  help      Show this help

Options:
  --dry-run      Measure only; delete nothing
  --deep         Include default-off deep hogs (e.g. ShipIt)
  --brave        Wider sweep: browsers/media caches (alias: --stupid)
  --stupid       Same as --brave
  --only id,...  Run only these task ids (after assess selection)
  -v, --verbose  Show command output

Config (per user, portable):
  ~/.config/janitor/disabled
  ~/.config/janitor/hogs

Desktop button:
  ./install.sh --desktop

Examples:
  janitor status
  janitor hogs
  janitor discover
  janitor adopt shipit
  janitor hog add ~/Library/Caches/my-tool
  janitor clean --dry-run
  janitor clean --brave --dry-run
  janitor desktop
  janitor clean --only homebrew,npm,old_logs
EOF
}

cmd_status() {
  banner "Janitor status" "$K_FACE"
  echo
  section "Disk"
  df_data
  echo
  explain_ram_vs_disk full
  echo
  section "RAM (snapshot only — not cleaned by Janitor)"
  ram_report
  echo
  section "Hogs (reclaimable disk)"
  report_sizes
  echo
  echo "${C_DIM}Policy: never Documents or Downloads. Brave tier = browsers/media caches.${C_RESET}"
  echo "${C_DIM}Opt-outs: ${JANITOR_DISABLED_FILE}  ·  Hogs: ${JANITOR_HOGS_FILE}${C_RESET}"
  echo "${C_DIM}More: janitor educate ram${C_RESET}"
  local latest
  latest="$(latest_log_path)"
  if [[ -n "$latest" && -f "$latest" ]]; then
    echo
    section "Last run"
    local real="$latest"
    if [[ -L "$latest" ]]; then
      real="$(readlink "$latest" 2>/dev/null || echo "$latest")"
    fi
    echo "  ${C_DIM}${real}${C_RESET}"
    grep -E '^(Disk freed |Freed |df avail|Log:|# janitor|☆|── summary)' "$latest" 2>/dev/null | sed 's/^/  /' \
      || echo "  (see $real)"
  fi
}

cmd_log() {
  local path_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --path) path_only=1 ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  local latest
  latest="$(latest_log_path)"
  if [[ -z "$latest" || ! -f "$latest" ]]; then
    die "no logs yet — run: janitor clean --dry-run"
  fi
  local real="$latest"
  if [[ -L "$latest" ]]; then
    real="$(readlink "$latest" 2>/dev/null || echo "$latest")"
  fi
  if [[ "$path_only" -eq 1 ]]; then
    echo "$real"
    return 0
  fi
  echo "Log: $real"
  echo
  cat "$latest"
}

cmd_clean() {
  local dry_run=0 verbose=0 deep=0 brave=0 only=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=1 ;;
      --deep) deep=1 ;;
      --brave|--stupid) brave=1 ;;
      --only)
        shift
        [[ $# -gt 0 ]] || die "--only needs a comma-separated id list"
        only="$1"
        ;;
      --only=*)
        only="${1#--only=}"
        ;;
      -v|--verbose) verbose=1 ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  DRY_RUN=$dry_run
  VERBOSE=$verbose
  DEEP=$deep
  BRAVE=$brave
  JANITOR_ONLY="$only"
  export DRY_RUN VERBOSE DEEP BRAVE JANITOR_ONLY

  local df_before
  df_before="$(free_kb)"
  log_init "clean"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    banner "Developer cleanup (dry-run)" "$K_DRY"
    log_echo "${C_YELLOW}${K_DRY} dry-run — nothing will be deleted${C_RESET}"
  else
    banner "Developer cleanup" "$K_SWEEP"
  fi
  if [[ "$DEEP" -eq 1 ]]; then
    log_echo "${C_CYAN}(deep profile enabled)${C_RESET}"
  fi
  if [[ "$BRAVE" -eq 1 ]]; then
    log_echo "${C_YELLOW}(brave/stupid profile — browsers & media caches; never Documents/Downloads)${C_RESET}"
  fi
  if [[ -n "$JANITOR_ONLY" ]]; then
    log_echo "${C_CYAN}(only: $JANITOR_ONLY)${C_RESET}"
  fi
  log_echo ""
  {
    echo "# RAM before"
    ram_report
    echo
  } | tee -a "$LOG_FILE"

  run_all_cleaners

  echo
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log_echo "${C_YELLOW}${K_OK} Dry-run complete.${C_RESET}"
  else
    log_echo "${C_GREEN}${K_DONE} Cleanup complete.${C_RESET}"
  fi
  log_finish "$df_before"
  echo
  {
    echo "# RAM after"
    ram_report
  } | tee -a "$LOG_FILE"
  echo
  df_data
}

cmd_desktop() {
  local deep=0 brave=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --deep) deep=1 ;;
      --brave|--stupid) brave=1 ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  if [[ "$deep" -eq 1 ]]; then
    export JANITOR_DESKTOP_DEEP=1
  fi
  if [[ "$brave" -eq 1 ]]; then
    export JANITOR_DESKTOP_BRAVE=1
  fi
  exec "$JANITOR_HOME/bin/janitor-desktop"
}

cmd_tasks() {
  list_tasks
}

cmd_disable() {
  [[ $# -ge 1 ]] || die "usage: janitor disable <task-id>"
  local id="$1" known=0 t
  for t in "${JANITOR_TASK_IDS[@]}"; do
    [[ "$t" == "$id" ]] && known=1 && break
  done
  [[ "$known" -eq 1 ]] || die "unknown task id: $id (try: janitor tasks)"
  task_disable "$id"
}

cmd_enable() {
  [[ $# -ge 1 ]] || die "usage: janitor enable <task-id>"
  task_enable "$1"
}

cmd_hog() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add)
      [[ $# -ge 1 ]] || die "usage: janitor hog add <path> [remove|contents]"
      cmd_hog_add "$@"
      ;;
    ""|-h|--help)
      echo "usage: janitor hog add <path> [remove|contents]"
      ;;
    *)
      die "unknown hog subcommand: $sub (try: janitor hog add <path>)"
      ;;
  esac
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    clean)    cmd_clean "$@" ;;
    desktop)  cmd_desktop "$@" ;;
    status)   cmd_status "$@" ;;
    hogs)     cmd_hogs "$@" ;;
    discover) cmd_discover "$@" ;;
    educate)
      [[ $# -ge 1 ]] || die "usage: janitor educate <id|ram>"
      cmd_educate "$1"
      ;;
    adopt)
      [[ $# -ge 1 ]] || die "usage: janitor adopt <id>"
      cmd_adopt "$1"
      ;;
    hog)      cmd_hog "$@" ;;
    tasks)    cmd_tasks "$@" ;;
    disable)  cmd_disable "$@" ;;
    enable)   cmd_enable "$@" ;;
    log)      cmd_log "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $cmd (try: janitor help)" ;;
  esac
}

main "$@"
