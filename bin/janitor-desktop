#!/bin/bash
# janitor-desktop — two-phase assess → confirm → clean (GUI dialogs)
set -euo pipefail

JANITOR_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JANITOR_BIN="$JANITOR_HOME/bin/janitor"

# Ensure brew/npm/dart visible when launched from Finder
export PATH="/opt/homebrew/bin:/usr/local/bin:${HOME}/bin:${HOME}/development/flutter/bin:/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}"
if [[ -d "${HOME}/.nvm/versions/node" ]]; then
  nvm_node="$(ls -d "${HOME}/.nvm/versions/node"/*/bin 2>/dev/null | sort -V | tail -1 || true)"
  [[ -n "${nvm_node:-}" ]] && export PATH="${nvm_node}:$PATH"
fi

osascript_escape() {
  # Escape for AppleScript double-quoted strings
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

dialog() {
  # dialog "message" "defaultButton" "btn1" "btn2" ...
  local message="$1" default_btn="$2"
  shift 2
  local buttons=("$@")
  local btn_list="" b
  for b in "${buttons[@]}"; do
    if [[ -n "$btn_list" ]]; then btn_list+=", "; fi
    btn_list+="\"$(osascript_escape "$b")\""
  done
  local msg_esc default_esc
  msg_esc="$(osascript_escape "$message")"
  default_esc="$(osascript_escape "$default_btn")"
  osascript <<EOF
try
  set r to button returned of (display dialog "${msg_esc}" with title "Janitor" buttons {${btn_list}} default button "${default_esc}" with icon caution)
  return r
on error number -128
  return "Cancel"
end try
EOF
}

notify() {
  local title="$1" body="$2"
  osascript -e "display notification \"$(osascript_escape "$body")\" with title \"$(osascript_escape "$title")\"" 2>/dev/null || true
}

alert() {
  local message="$1"
  osascript <<EOF
display dialog "$(osascript_escape "$message")" with title "Janitor" buttons {"OK"} default button "OK" with icon note
EOF
}

# janitor-desktop has its own Assess / Assess (deep) buttons.
# If JANITOR_DESKTOP_DEEP=1, skip straight to deep assess after the intro.
INTRO_DEFAULT="Assess"
INTRO_BUTTONS=("Cancel" "Assess" "Assess (deep)")
if [[ "${JANITOR_DESKTOP_DEEP:-0}" == "1" ]]; then
  choice="Assess (deep)"
else
  choice="$(dialog \
    "Janitor will assess reclaimable developer caches.

Never touches Documents or Downloads.

Phase 1: assess (dry-run)
Phase 2: you accept → then clean" \
    "$INTRO_DEFAULT" "${INTRO_BUTTONS[@]}")"
fi

case "$choice" in
  Cancel|"") exit 0 ;;
  "Assess (deep)") DEEP_FLAG=(--deep) ;;
  *) DEEP_FLAG=() ;;
esac

notify "Janitor" "Assessing what can be cleaned…"

# --- Phase 1: assess ---
assess_out="$("$JANITOR_BIN" clean --dry-run "${DEEP_FLAG[@]}" 2>&1)" || true
assess_log="$("$JANITOR_BIN" log --path 2>/dev/null || true)"

freed_line="$(printf '%s\n' "$assess_out" | grep -E '^Freed \(measured\):' | tail -1 || true)"
[[ -z "$freed_line" ]] && freed_line="Freed (measured): unknown"

# Build short task list (bullet lines only, cap length for dialog)
task_lines="$(printf '%s\n' "$assess_out" | grep '^•' | grep -v 'skipped' || true)"
task_summary="$(printf '%s\n' "$task_lines" | head -16)"
extra_count="$(printf '%s\n' "$task_lines" | wc -l | tr -d ' ')"
if [[ "${extra_count:-0}" -gt 16 ]]; then
  task_summary+=$'\n'"… and $((extra_count - 16)) more (see log)"
fi

confirm_msg="ASSESSMENT

${freed_line}

What would be cleaned:
${task_summary}

Full log:
${assess_log:-~(none)}

Proceed with cleanup? This cannot be undone for cleared caches."

confirm="$(dialog "$confirm_msg" "Cancel" "Cancel" "Clean now")"

case "$confirm" in
  "Clean now") ;;
  *)
    notify "Janitor" "Cleanup cancelled — nothing deleted."
    exit 0
    ;;
esac

# --- Phase 2: exterminate ---
notify "Janitor" "Cleaning…"
clean_out="$("$JANITOR_BIN" clean "${DEEP_FLAG[@]}" 2>&1)" || true
clean_log="$("$JANITOR_BIN" log --path 2>/dev/null || true)"
result_line="$(printf '%s\n' "$clean_out" | grep -E '^Freed \(measured\):' | tail -1 || true)"
[[ -z "$result_line" ]] && result_line="Cleanup finished."

alert "Cleanup complete.

${result_line}

Log:
${clean_log:-~(none)}"

notify "Janitor" "${result_line}"
