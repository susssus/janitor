#!/bin/bash
# janitor-desktop — assess → checkbox opt-out → clean
set -euo pipefail

JANITOR_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JANITOR_BIN="$JANITOR_HOME/bin/janitor"

# shellcheck source=../lib/common.sh
source "$JANITOR_HOME/lib/common.sh"
# shellcheck source=../lib/config.sh
source "$JANITOR_HOME/lib/config.sh"

janitor_augment_path
config_ensure

osascript_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

dialog() {
  local message="$1" default_btn="$2"
  shift 2
  local buttons=("$@") btn_list="" b
  for b in "${buttons[@]}"; do
    [[ -n "$btn_list" ]] && btn_list+=", "
    btn_list+="\"$(osascript_escape "$b")\""
  done
  local msg_esc default_esc
  msg_esc="$(osascript_escape "$message")"
  default_esc="$(osascript_escape "$default_btn")"
  osascript <<EOF
try
  set r to button returned of (display dialog "${msg_esc}" with title "Janitor" buttons {${btn_list}} default button "${default_esc}" with icon caution)
  return r
on error number -128
  return "Cancel"
end try
EOF
}

notify() {
  local title="$1" body="$2"
  osascript -e "display notification \"$(osascript_escape "$body")\" with title \"$(osascript_escape "$title")\"" 2>/dev/null || true
}

SWEEP_ANIM_PID=""

# Cycle 🧹 frames in Notification Center while a blocking clean/assess runs.
sweep_anim_start() {
  local phase="${1:-Sweeping}"
  (
    local frames=("🧹" "🧹 💨" "💨 🧹" "✨ 🧹")
    local i=0 n=${#frames[@]}
    while true; do
      notify "${frames[$i]} Janitor" "${phase} underway…"
      i=$(( (i + 1) % n ))
      sleep 0.75
    done
  ) &
  SWEEP_ANIM_PID=$!
}

sweep_anim_stop() {
  [[ -z "${SWEEP_ANIM_PID:-}" ]] && return 0
  kill "$SWEEP_ANIM_PID" 2>/dev/null || true
  wait "$SWEEP_ANIM_PID" 2>/dev/null || true
  SWEEP_ANIM_PID=""
}

trap 'sweep_anim_stop' EXIT

# Task bullet lines from a session log (• npm cache  freed 1.2G …).
log_task_summary() {
  local logfile="$1"
  local max="${2:-15}"
  if [[ ! -f "$logfile" ]]; then
    echo "(no log yet)"
    return 0
  fi
  local lines
  lines="$(grep -E '^• ' "$logfile" 2>/dev/null | tail -n "$max")"
  if [[ -z "$lines" ]]; then
    echo "(no task lines)"
  else
    printf '%s\n' "$lines"
  fi
}

alert() {
  local message="$1"
  osascript <<EOF
display dialog "$(osascript_escape "$message")" with title "🧹 Janitor" buttons {"OK"} default button "OK" with icon note
EOF
}

# Build AppleScript list from last-assess.tsv; user deselects to opt out.
# Prints selected task ids as comma-separated on stdout; CANCEL / EMPTY on special cases.
choose_tasks() {
  local assess="$JANITOR_ASSESS_TSV"
  if [[ ! -f "$assess" ]]; then
    echo "EMPTY"
    return 0
  fi

  local items=() defaults=() line id label freed status display
  while IFS=$'\t' read -r id label freed status; do
    [[ "$id" == "id" ]] && continue
    [[ -z "$id" ]] && continue
    # Only offer tasks that would reclaim something
    [[ "${freed:-0}" -gt 0 ]] || continue
    display="${id} — ${label} ($(fmt_kb "$freed"))"
    items+=("$display")
    defaults+=("$display")
  done <"$assess"

  if [[ ${#items[@]} -eq 0 ]]; then
    echo "EMPTY"
    return 0
  fi

  # Write AppleScript list literals
  local list_lit="" def_lit="" it
  for it in "${items[@]}"; do
    [[ -n "$list_lit" ]] && list_lit+=", "
    list_lit+="\"$(osascript_escape "$it")\""
  done
  for it in "${defaults[@]}"; do
    [[ -n "$def_lit" ]] && def_lit+=", "
    def_lit+="\"$(osascript_escape "$it")\""
  done

  local chosen
  chosen="$(osascript <<EOF
try
  set taskList to {${list_lit}}
  set defaultList to {${def_lit}}
  set chosen to choose from list taskList with title "Janitor" with prompt "Deselect anything you do NOT want cleaned (all selected = clean all):" default items defaultList with multiple selections allowed
  if chosen is false then
    return "CANCEL"
  end if
  set text item delimiters of AppleScript to linefeed
  return chosen as text
on error number -128
  return "CANCEL"
end try
EOF
)"

  if [[ "$chosen" == "CANCEL" || -z "$chosen" ]]; then
    echo "CANCEL"
    return 0
  fi

  # Extract ids (text before " — ")
  local selected_ids=() row
  while IFS= read -r row; do
    [[ -z "$row" ]] && continue
    selected_ids+=("${row%% — *}")
  done <<<"$chosen"

  if [[ ${#selected_ids[@]} -eq 0 ]]; then
    echo "EMPTY"
    return 0
  fi

  local IFS=,
  echo "${selected_ids[*]}"
}

# Compare assess ids vs selected → permanently disable deselected if user agrees
maybe_remember_optouts() {
  local selected_csv="$1"
  local assess="$JANITOR_ASSESS_TSV"
  local deselected=() id label freed status
  while IFS=$'\t' read -r id label freed status; do
    [[ "$id" == "id" ]] && continue
    [[ -z "$id" ]] && continue
    [[ "${freed:-0}" -gt 0 ]] || continue
    case ",${selected_csv}," in
      *",${id},"*) ;;
      *) deselected+=("$id") ;;
    esac
  done <"$assess"

  [[ ${#deselected[@]} -gt 0 ]] || return 0

  local list
  list="$(printf '%s, ' "${deselected[@]}")"
  list="${list%, }"
  local ans
  ans="$(dialog \
    "Remember these opt-outs for next time?

${list}

Saved in ~/.config/janitor/disabled" \
    "Not now" "Not now" "Remember")"
  if [[ "$ans" == "Remember" ]]; then
    local d
    for d in "${deselected[@]}"; do
      task_disable "$d" >/dev/null
    done
    notify "Janitor" "Saved ${#deselected[@]} opt-out(s)"
  fi
}

# --- Phase 0 ---
if [[ "${JANITOR_DESKTOP_DEEP:-0}" == "1" ]]; then
  choice="Assess (deep)"
else
  choice="$(dialog \
    "Janitor will assess reclaimable developer caches.

Never touches Documents or Downloads.

1) Assess
2) Uncheck what to keep
3) Clean only what you left checked" \
    "Assess" "Cancel" "Assess" "Assess (deep)")"
fi

case "$choice" in
  Cancel|"") exit 0 ;;
  "Assess (deep)") DEEP_FLAG=(--deep) ;;
  *) DEEP_FLAG=() ;;
esac

sweep_anim_start "Assessing"

# --- Phase 1: assess ---
assess_out="$("$JANITOR_BIN" clean --dry-run "${DEEP_FLAG[@]}" 2>&1)" || true
sweep_anim_stop
assess_log="$("$JANITOR_BIN" log --path 2>/dev/null || true)"
freed_line="$(printf '%s\n' "$assess_out" | grep -E '^Freed \(measured\):' | tail -1 || true)"
[[ -z "$freed_line" ]] && freed_line="Freed (measured): unknown"

# --- Phase 1b: checkboxes ---
selected="$(choose_tasks)"
case "$selected" in
  CANCEL)
    notify "Janitor" "Cleanup cancelled — nothing deleted."
    exit 0
    ;;
  EMPTY)
    none_log="${assess_log:-none}"
    alert "🧹 Nothing to sweep right now.

${freed_line}

Log:
${none_log}"
    exit 0
    ;;
esac

maybe_remember_optouts "$selected"

confirm="$(dialog \
  "Ready to clean selected tasks:

${selected}

${freed_line} (full assess; only selected will run)

Proceed?" \
  "Cancel" "Cancel" "Clean now")"

case "$confirm" in
  "Clean now") ;;
  *)
    notify "Janitor" "Cleanup cancelled — nothing deleted."
    exit 0
    ;;
esac

# --- Phase 2 ---
sweep_anim_start "Sweeping"
clean_out="$("$JANITOR_BIN" clean "${DEEP_FLAG[@]}" --only "$selected" 2>&1)" || true
sweep_anim_stop
clean_log="$("$JANITOR_BIN" log --path 2>/dev/null || true)"
result_line="$(printf '%s\n' "$clean_out" | grep -E '^Freed \(measured\):' | tail -1 || true)"
[[ -z "$result_line" ]] && result_line="Cleanup finished."
none_log="${clean_log:-none}"
log_summary="$(log_task_summary "$clean_log")"

alert "🧹 Hooray! Cleanup complete.

${result_line}

Swept:
${log_summary}

Full log:
${none_log}"

notify "🧹 Janitor" "Hooray! ${result_line}"
