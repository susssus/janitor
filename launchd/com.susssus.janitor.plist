<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.susssus.janitor</string>

  <key>ProgramArguments</key>
  <array>
    <string>__JANITOR_BIN__</string>
    <string>clean</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <!-- Sunday at 10:00 local time -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>__HOME__</string>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/janitor.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/janitor.err.log</string>
</dict>
</plist>
